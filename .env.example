# Server Configuration
PORT=3000
NODE_ENV=production

# Gemini AI API Key (Server-side key for AI medical report analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (for Client-Side & Auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# MySQL Database Connection Options
# Option 1: Direct Connection URL (e.g., PlanetScale, Aiven, Railway, Render MySQL, or Local MySQL)
MYSQL_URL=mysql://root:password@localhost:3306/usg_reporting_db
DATABASE_URL=mysql://root:password@localhost:3306/usg_reporting_db

# Option 2: Individual Connection Fields
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=usg_reporting_db

# Optional: Application Host URL
APP_URL=http://localhost:3000
